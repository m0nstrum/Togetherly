<?xml version="1.0" encoding="utf-8"?>
<!--
  Что НЕ уезжает в автобэкап Android (API < 31; для 31+ см. data_extraction_rules.xml).

  • FlutterSharedPreferences.xml — там лежит токен сессии PocketBase (AsyncAuthStore).
  • offline/ — офлайн-кэш: база sembast `pb_cache.db` со всей перепиской пары и
    очередью отправки, плюс `pending_media` (фото и видео, ещё не залитые на сервер).
    Кэш восстанавливается с сервера за одну синхронизацию, а копия переписки на
    Google Drive не нужна ни при каких условиях. База с 1.19 ещё и зашифрована
    ключом из Keystore, который в бэкап не попадает — восстановленный файл всё
    равно не открылся бы.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <!-- fork (PLAN 1.6): secrets, wrapped keys and cipher configuration -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="TetheredAuth.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:TetheredAuth.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:TetheredAuth.xml"/>
        <exclude domain="sharedpref" path="TetheredCache.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:TetheredCache.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:TetheredCache.xml"/>
        <exclude domain="sharedpref" path="TetheredE2E.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:TetheredE2E.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:TetheredE2E.xml"/>
    <exclude domain="file" path="offline"/>
</full-backup-content>

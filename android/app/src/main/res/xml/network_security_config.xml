<?xml version="1.0" encoding="utf-8"?>
<!--
  fork: cleartext-исключение для Bugsink апстрима (IP 77.91.95.34) убрано.
  Свой Bugsink форка ходит по HTTPS (SENTRY_DSN), весь трафик HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!--
      fork (S9): локальный прокси расшифровки медиа (lib/fork/e2e/media_proxy.dart)
      слушает только 127.0.0.1; плеер видео (ExoPlayer) ходит к нему по http.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!--
  «Настроение» 2×2 в тесной ячейке (B7): макет tg_mood_2x2 с меньшими полями,
  отступами и кнопками выбора. Полный просит 123dp при гарантированных
  110dp — кнопки срезались. Выбирает MoodTilesWidgetProvider через
  WidgetSizing.fit, влезание сверяет tool/fork/widget_fit.py. id те же.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="9dp">

        <TextView
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11dp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:includeFontPadding="false"
            android:text="СЕГОДНЯ" />

        <!-- Моя строка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/my_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/tg_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/my_line"
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:textSize="12dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Я" />
        </LinearLayout>

        <!-- Строка партнёра -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/partner_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/tg_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/partner_line"
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:textSize="12dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Партнёр" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <!-- Выбор настроения: тап отмечает мой день -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/pick_good"
                android:layout_width="1dp"
                android:layout_height="28dp"

                android:layout_weight="1">

                <ImageView
                    android:id="@+id/pick_good_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_14"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/pick_good_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tg_mood_good"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pick_ok"
                android:layout_width="1dp"
                android:layout_height="28dp"

                android:layout_weight="1"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/pick_ok_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_14"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/pick_ok_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tg_mood_ok"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pick_bad"
                android:layout_width="1dp"
                android:layout_height="28dp"

                android:layout_weight="1"
                android:layout_marginStart="6dp">

                <ImageView
                    android:id="@+id/pick_bad_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_14"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/pick_bad_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tg_mood_bad"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

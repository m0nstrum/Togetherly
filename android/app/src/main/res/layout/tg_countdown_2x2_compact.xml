<?xml version="1.0" encoding="utf-8"?>
<!--
  «До встречи» 2×2 в тесной ячейке (B7): макет tg_countdown_2x2 с меньшими
  полями и числом, без значка события. Полный просит ≈132dp при
  гарантированных 110dp. Выбирает CountdownWidgetProvider через
  WidgetSizing.fit, влезание сверяет tool/fork/widget_fit.py. id те же.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <TextView
            android:id="@+id/days_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32dp"
            android:textStyle="bold"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—" />

        <TextView
            android:id="@+id/days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="11dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="дней до встречи" />

        <ImageView
            android:id="@+id/event_icon"
            android:visibility="gone"

            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_tg_event"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>

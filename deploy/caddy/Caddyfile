# Внешний вход: HTTPS (Let's Encrypt сам), WebSocket Centrifugo и сервер.
# HTTP API Centrifugo (/api на его порту) наружу не выпускается.
#
# Наружу только 443 (tcp и udp для HTTP/3): сертификат по TLS-ALPN-01 на том
# же порту, порт 80 не нужен.

{$TETHERED_DOMAIN} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# PLAN 1.5: PocketBase dashboard and superuser APIs stay private.
	# Match the collection ID as well: PB accepts both names and IDs in URLs.
	@admin path /_ /_/* /api/collections/_superusers /api/collections/_superusers/* /api/collections/pbc_3142635823 /api/collections/pbc_3142635823/*
	respond @admin 404

	encode zstd gzip

	@ws path /connection/websocket
	reverse_proxy @ws centrifugo:8000

	reverse_proxy server:8090
}

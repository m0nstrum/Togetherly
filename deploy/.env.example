# Домен инстанса: на него указывает A-запись, с него Caddy берёт сертификат.
TETHERED_DOMAIN=tethered.example.org

# Секреты — длинные случайные строки: openssl rand -hex 32
CENTRIFUGO_TOKEN_HMAC=
CENTRIFUGO_API_KEY=
TURN_SECRET=

# Почта для подтверждения адреса и сброса пароля (свой SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_TLS=false

# Свой ключ api.poiskkino.dev (необязательно): запасной поиск фильмов, когда
# в Викиданных пусто. Без него ищем только в Викиданных.
POISKKINO_KEY=

# Бэкапы PocketBase. С ключом age каждый шифруется в том server-backups (его
# уносите с машины), открытая копия удаляется. Ключ — публичная половина:
#   age-keygen -o tethered-backup-key.txt   # секретный файл храните НЕ здесь
BACKUP_CRON=0 3 * * *
BACKUP_MAX_KEEP=7
BACKUP_AGE_RECIPIENTS=

# Bugsink (профиль crash).
BUGSINK_SECRET_KEY=
BUGSINK_ADMIN=admin:change-me

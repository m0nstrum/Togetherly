# JS-хуки апстрима (pocketbase/pb_hooks), которые сервер форка запускает как
# есть, пока они не перенесены на Go (docs/fork/API_INVENTORY.md).
# Собирает каталог scripts/sync-hooks.sh. Строка — имя файла; # — комментарий.
#
# Не берём: centrifugo.pb.js (рассылка на Go), watch_rtc.pb.js (на Go),
# push_apns/apple_*/lava*/plus_*/donations/income*/redeem/wallet_waitlist/
# migrate_bridge/profile_web/gmail_mailer/widget_plus/filecheck/link_preview
# (выкинуты или переписываются в S5).
# gift_push*.js — тоже нет: подарок будит получателя будильник форка
# (domain/wake, push-рассылка в user:<uid> не нужна), а онлайн-проверка
# хука ходит в /internal/online hotpath, которого у форка нет — без неё
# уведомление о подарке дублировалось бы с уведомлением приложения.

# Пары, группы, приглашения
invite.pb.js
invite_web.pb.js
groups.pb.js
groups_guard.pb.js
groups_membership.pb.js
waiting.pb.js
user_card.pb.js
couple_stats.pb.js
counters.pb.js
comments_count.pb.js
comments_count.js

# Аккаунт
email_case.pb.js
email_change.pb.js
users_guard.pb.js

# Realtime
centrifugo_tokens.pb.js

# Чат, желания, рисунки, «Смотрим вместе»
chat_guard.pb.js
wishes_guard.pb.js
draw_invite.pb.js
draw_invite.js
reels_invite.pb.js
reels_invite.js
watch.pb.js
widget_anim.pb.js

# Монеты, сундук, подарки — игровая механика без денег (API_INVENTORY §2)
coins.pb.js
chest.pb.js
gifts.pb.js
frame_gift.pb.js
pair_jar.js

# Метаданные (до meta gateway в S5)
music.pb.js

# Общий модуль пушей апстрима: его зовут coins, draw_invite, reels_invite.
# Ретрансляторы APNs/FCM в форке не подняты — отправка молча не происходит.
apns_push.js
